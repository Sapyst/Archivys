const IDIOMAS := {"en": EN}

## Texto da chave no idioma atual (fallback: EN, depois a própria chave), com % args se houver.
static func t(chave: String, args: Array = []) -> String:
	var tabela: Dictionary = IDIOMAS.get(idioma, EN)
	var s: String = tabela.get(chave, EN.get(chave, chave))
	if args.is_empty():
		return s
	return s % args

## true se a chave existe em EN.
static func tem(chave: String) -> bool:
	return EN.has(chave)
